{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collabo",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collabodb",
      "database_id": "8a6b6dc0-c632-4adc-86a8-4477e602b20d"
    }
  ]
}
